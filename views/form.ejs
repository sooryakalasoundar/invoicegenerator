    function addRow() {
      const tbody = document.getElementById('itemsBody');
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><input name="details[]" class="form-control" placeholder="Details" required /></td>
        <td><input name="quantity[]" type="number" class="form-control" placeholder="Qty" required /></td>
        <td><input name="rate_per[]" type="number" step="0.01" class="form-control" placeholder="Rate" required /></td>
        <td class="text-center"><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Remove</button></td>
      `;
      tbody.appendChild(row);
    }
    function removeRow(button) {
      const row = button.closest('tr');
      row.remove();
    }
  </script>
</head>
<body>
 <center>   
 <h1>Create Invoice</h1>
 <div class="col-md-6">
 <form action="/invoices" method="POST" >
    <table class="table table-bordered align-middle">
      <tbody>
        <tr>
          <th>Invoice To</th>
          <td colspan="3"><input name="invoice_to" class="form-control" required /></td>
        </tr>
        <tr>
          <th>Date</th>
          <td colspan="3"><input type="date" name="inv_date" class="form-control" required /></td>
        </tr>
        <tr class="table-primary text-center">
          <th>Details</th>
          <th>Quantity</th>
          <th>Rate</th>
          <th>Action</th>
        </tr>
        <tbody id="itemsBody">
          <tr>
            <td><input name="details[]" class="form-control" required /></td>
            <td><input name="quantity[]" type="number" class="form-control" required /></td>
            <td><input name="rate_per[]" type="number" step="0.01" class="form-control" required /></td>
            <td class="text-center"><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Remove</button></td>
          </tr>
        </tbody>
        <tr>
          <td colspan="4" class="text-center">
            <button type="button" class="btn btn-primary" onclick="addRow()">+ Add Item</button>
          </td>
        </tr>
      </tbody>
    </table>
     <button type="submit" class="btn btn-success">Submit Invoice</button><br><br>
     <button type="button"  class=" btn-sm rounded-pill shadow px-4" onClick="goHome()">HOME</button>
      <script>
       function goHome(){
            window.location.href='/homepage';
        }
      </script>
      </form>
  </div>
</body>
</html>
