<!-- views/invoices.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title>All Invoices</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>
  <center>   <br>
  <h2>Invoices List</h2>
  <table class="table-bordered" style="font-size: 24px;" cellpadding="5">
    <thead>
      <tr>
        <th>Invoice ID</th>
        <th>To</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.forEach(invoice => { %>
        <tr>
          <td><%= invoice.invoice_id %></td>
          <td><%= invoice.invoice_to %></td>
         <!-- <td><%= invoice.inv_date %></td> -->
          <td><%= invoice.inv_date?.toLocaleDateString().split('T')[0] || 'N/A' %></td> 
          <td>
            <a href="/invoices/<%= invoice.id %>/edit">Edit</a> |
            <a href="/invoices/<%= invoice.id %>">View</a> |
            <a href="/printinvoice/<%= invoice.id %>">Download PDF</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table> 
  <br>
  <button type="button"  class="btn btn-primary btn-lg rounded-pill shadow px-4" onClick="goHome()">HOME</button>
  <script>
   function goHome(){
        window.location.href='/homepage';
    }
  </script>

</body>
</html>
