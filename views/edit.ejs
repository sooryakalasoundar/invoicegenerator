<!DOCTYPE html>
<html>
<head>
  <title>Edit Invoice</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    .item { margin-bottom: 10px; }
    .item input { margin-right: 5px; }
    .remove-btn { color: red; cursor: pointer; margin-left: 10px; }
  </style>
</head>
<body>
  <br>
  <center><h2>Edit Invoice</h2></center>

  <form action="/invoices/<%= invoice.id %>/edit" method="POST" class="container mt-4">

  <h3 class="mb-3">Edit Invoice - <%= invoice.invoice_id %></h3>

  <div class="mb-3">
    <label class="form-label">Invoice To:</label>
    <input class="form-control" name="invoice_to" value="<%= invoice.invoice_to %>" required />
  </div>

  <div class="mb-4">
    <label class="form-label">Date:</label>
    <input type="date" class="form-control" name="inv_date" value="<%= new Date(invoice.inv_date).toISOString().split('T')[0] %>" required />
  </div>

  <h4>Items</h4>
  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center" id="itemsTable">
      <thead class="table-light">
        <tr>
          <th>Details</th>
          <th>Quantity</th>
          <th>Rate Per</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="items">
        <% items.forEach((item) => { %>
          <tr class="item" data-item-id="<%= item.id %>">
            <input type="hidden" name="item_ids[]" value="<%= item.id %>" />
            <td><input class="form-control" name="details[]" value="<%= item.details %>" required /></td>
            <td><input class="form-control" name="quantity[]" type="number" value="<%= item.quantity %>" required /></td>
            <td><input class="form-control" name="rate_per[]" type="number" step="0.01" value="<%= item.rate_per %>" required /></td>
            <td>
              <button type="button" class="btn btn-sm btn-danger" onclick="deleteItem(this, <%= item.id %>)">❌</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="mb-3 text-end">
    <button type="button" class="btn btn-secondary" onclick="addRow()">+ Add Item</button>
  </div>

  <div class="d-flex justify-content-between mt-4">
    <button type="submit" class="btn btn-primary">Update Invoice</button>
    <button type="button" class="btn btn-warning" onclick="goHome()">HOME</button>
    <button type="button" class="btn btn-dark" onclick="goBack()">BACK</button>
  </div>
</form>
<script>
  // Navigate to homepage
  function goHome() {
    window.location.href = '/homepage';
  }

  // Navigate back to invoice list
  function goBack() {
    window.location.href = '/invoices';
  }

  // Add a new item row to the table
  function addRow() {
    const tbody = document.getElementById('items');
    const row = document.createElement('tr');
    row.className = 'item';
    row.innerHTML = `
      <input type="hidden" name="item_ids[]" value="">
      <td><input class="form-control" name="details[]" placeholder="Details" required /></td>
      <td><input class="form-control" name="quantity[]" type="number" placeholder="Qty" required /></td>
      <td><input class="form-control" name="rate_per[]" type="number" step="0.01" placeholder="Rate" required /></td>
      <td><button type="button" class="btn btn-sm btn-danger" onclick="deleteRow(this)">❌</button></td>
    `;
    tbody.appendChild(row);
  }

  // Delete a row (without itemId – for new rows)
  function deleteRow(button) {
    const row = button.closest('tr');
    if (row) row.remove();
  }

  // Delete a row (with server-side request for existing items)
  function deleteItem(button, itemId) {
    if (confirm('Are you sure you want to delete this item?')) {
      fetch(`/items/${itemId}/delete`, { method: 'DELETE' })
        .then(response => {
          if (response.ok) {
            const row = button.closest('tr');
            if (row) row.remove();
          } else {
            alert('Failed to delete item.');
          }
        })
        .catch(err => {
          console.error(err);
          alert('Error deleting item.');
        });
    }
  }
</script>
</body>
</html>
